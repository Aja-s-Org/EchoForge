{
  "name": "@echoforge/storage-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "./packages/storage-utils/src",
  "projectType": "library",
  "tags": ["type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "./dist/packages/storage-utils",
        "main": "./packages/storage-utils/src/index.ts",
        "tsConfig": "./packages/storage-utils/tsconfig.lib.json",
        "assets": ["./packages/storage-utils/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/packages/storage-utils"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/packages/storage-utils"
      }
    },
    "coverage": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/packages/storage-utils"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/packages/storage-utils",
        "coverage": {
          "enabled": true,
          "provider": "v8",
          "reportsDirectory": "../../coverage/packages/storage-utils",
          "reporter": ["text", "json", "html", "json-summary"]
        }
      }
    }
  }
}
