{
  "name": "echoforge",
  "version": "0.0.0",
  "description": "Node.js and C++ Demo of a Voice Cloning App",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "homepage": "https://github.com/AjaSharma93/EchoForge#readme",
  "bugs": {
    "url": "https://github.com/AjaSharma93/EchoForge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjaSharma93/EchoForge.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "scripts": {
    "prepare": "npx husky install",
    "build": "nx run-many --target=build",
    "lint": "nx run-many --target=lint --all --quiet --exclude='frontend'",
    "deploy": "nx run-many --target=deploy",
    "destroy": "nx run-many --target=destroy",
    "test": "nx affected --base=origin/main --target=coverage --parallel",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "info": "node output-urls.js",
    "release:dry-run": "nx release --dry-run",
    "changelog": "nx release changelog --git-commit --git-push",
    "release": "nx release",
    "release:alpha": "nx release --preid=alpha --skip-publish",
    "release:alpha:dry-run": "nx release --preid=alpha --skip-publish --dry-run",
    "diagram": "nx run-many --target=diagram"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@nx/eslint": "20.6.1",
    "@nx/eslint-plugin": "20.6.4",
    "@nx/jest": "21.5.1",
    "@nx/js": "21.5.1",
    "@nx/vite": "21.5.1",
    "@nx/web": "21.5.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jiti": "2.6.1",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.19"
  }
}
