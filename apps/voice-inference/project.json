{
  "name": "voice-inference",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/voice-inference/src",
  "projectType": "application",
  "tags": ["type:app", "lang:python"],
  "targets": {
    "fetch-f5-tts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/f5-tts.json", "{projectRoot}/scripts/f5-tts.mjs"],
      "outputs": ["{workspaceRoot}/dist/third_party/f5-tts/src"],
      "options": {
        "command": "node apps/voice-inference/scripts/f5-tts.mjs fetch"
      }
    },
    "build-f5-tts": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["fetch-f5-tts"],
      "inputs": ["{projectRoot}/f5-tts.json", "{projectRoot}/scripts/f5-tts.mjs", { "env": "PYTHON" }],
      "outputs": ["{workspaceRoot}/dist/third_party/f5-tts/wheel"],
      "options": {
        "command": "node apps/voice-inference/scripts/f5-tts.mjs wheel"
      }
    },
    "test-python": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*.py",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/f5-tts.json",
        "{projectRoot}/requirements-test.txt",
        "{projectRoot}/pyproject.toml",
        "{projectRoot}/scripts/test.sh",
        { "env": "PYTHON" }
      ],
      "options": {
        "command": "bash apps/voice-inference/scripts/test.sh"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-f5-tts"],
      "options": {
        "command": "echo 'Please specify a cloud configuration: -c gcp'"
      },
      "configurations": {
        "gcp": {
          "command": "docker build --platform linux/amd64 -t us-central1-docker.pkg.dev/echoforge-494507/echoforge-repo/voice-inference:latest -f apps/voice-inference/Dockerfile ."
        }
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-build"],
      "options": {
        "command": "echo 'Please specify a cloud configuration: -c gcp'"
      },
      "configurations": {
        "gcp": {
          "command": "docker push us-central1-docker.pkg.dev/echoforge-494507/echoforge-repo/voice-inference:latest"
        }
      }
    }
  }
}
