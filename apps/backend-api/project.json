{
  "name": "backend-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "./apps/backend-api/src",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "./dist/apps/backend-api",
        "main": "./apps/backend-api/src/main.ts",
        "tsConfig": "./apps/backend-api/tsconfig.lib.json",
        "assets": ["./apps/backend-api/*.md"],
        "generatePackageJson": true,
        "generateLockfile": true
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "echo 'Please specify a cloud configuration: -c gcp or -c aws'"
      },
      "configurations": {
        "gcp": {
          "command": "docker build --platform linux/amd64 -t us-central1-docker.pkg.dev/echoforge-494507/echoforge-repo/backend-api:latest -f apps/backend-api/Dockerfile ."
        },
        "aws": {
          "command": "docker build --platform linux/amd64 -t 715841371829.dkr.ecr.us-east-1.amazonaws.com/echoforge-api:latest -f apps/backend-api/Dockerfile ."
        }
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-build"],
      "options": {
        "command": "echo 'Please specify a cloud configuration: -c gcp or -c aws'"
      },
      "configurations": {
        "gcp": {
          "command": "docker push us-central1-docker.pkg.dev/echoforge-494507/echoforge-repo/backend-api:latest"
        },
        "aws": {
          "command": "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 715841371829.dkr.ecr.us-east-1.amazonaws.com && docker push 715841371829.dkr.ecr.us-east-1.amazonaws.com/echoforge-api:latest"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "backend-api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "backend-api:build:development"
        },
        "production": {
          "buildTarget": "backend-api:build:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-push"],
      "options": {
        "command": "terraform init && terraform apply -auto-approve"
      },
      "configurations": {
        "gcp": {
          "cwd": "infrastructure/gcp"
        },
        "aws": {
          "cwd": "infrastructure/aws"
        }
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform destroy"
      },
      "configurations": {
        "gcp": {
          "cwd": "infrastructure/gcp"
        },
        "aws": {
          "cwd": "infrastructure/aws"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/apps/backend-api"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/backend-api"
      }
    },
    "coverage": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/apps/backend-api"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/apps/backend-api",
        "coverage": {
          "enabled": true,
          "provider": "v8",
          "reportsDirectory": "../../coverage/apps/backend-api",
          "reporter": ["text", "json", "html", "json-summary"]
        }
      }
    }
  }
}
